# Copier ce fichier en ".env" (jamais committé) puis remplir les valeurs.
# Aucune clé ne doit apparaître dans le code ni dans les fichiers rendus.

# Clé secrète Django (optionnelle en local : une clé aléatoire est générée si elle est absente)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Flux AIS en direct (aisstream.io) : inscription gratuite sur https://aisstream.io (connexion GitHub)
# Avec la clé, `python manage.py runserver` ouvre tout seul un lien permanent : les navires bougent en temps réel.
# Sans clé, le tableau de bord affiche un message clair et utilise l'archive AIS du TP.
AISSTREAM_API_KEY=

# Durées de validité (secondes) avant de rappeler une source en direct
WEATHER_TTL_SECONDS=900
AIS_STALE_SECONDS=900
